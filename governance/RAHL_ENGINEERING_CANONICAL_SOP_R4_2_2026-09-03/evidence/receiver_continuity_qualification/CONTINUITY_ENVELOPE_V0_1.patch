+from __future__ import annotations
+
+import json
+import os
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from app_factory import create_app
+from continuity_envelope import (
+    build_continuity_envelope,
+    project_and_session_from_request,
+)
+from control_plane_models import ToolResultEnvelope
+
+
+PROJECT_ID = "pcmmad-receiver-continuity-envelope-v0-1"
+API_KEY = "continuity-test-key"
+
+
+class ContinuityEnvelopeUnitTests(unittest.TestCase):
+    def test_extracts_direct_and_nested_identity(self) -> None:
+        self.assertEqual(
+            ("alpha", "s1"),
+            project_and_session_from_request(
+                {"project_id": "alpha", "session_id": "s1"}, {}
+            ),
+        )
+        self.assertEqual(
+            ("beta", "s2"),
+            project_and_session_from_request(
+                {"tool_name": "x", "payload": {"project_id": "beta", "session_id": "s2"}},
+                {},
+            ),
+        )
+        self.assertEqual(
+            ("gamma", "header-session"),
+            project_and_session_from_request(
+                {}, {"project_id": "gamma"}, header_session_id="header-session"
+            ),
+        )
+
+    def test_tool_result_envelope_omits_or_carries_continuity(self) -> None:
+        base = dict(
+            ok=True,
+            tool="project.files.list",
+            danger_tier="low",
+            policy_mode="NORMAL",
+            approved=True,
+            time="t",
+            result={"ok": True},
+        )
+        plain = ToolResultEnvelope(**base).to_dict()
+        self.assertNotIn("continuity", plain)
+        enriched = ToolResultEnvelope(
+            **base, continuity={"schema": "pcmmad.continuity-envelope.v1"}
+        ).to_dict()
+        self.assertEqual(
+            "pcmmad.continuity-envelope.v1", enriched["continuity"]["schema"]
+        )
+
+    def test_candidate_project_builds_bounded_recovery_state(self) -> None:
+        envelope = build_continuity_envelope(PROJECT_ID, session_id="unit-session")
+        self.assertEqual("pcmmad.continuity-envelope.v1", envelope["schema"])
+        self.assertEqual(PROJECT_ID, envelope["project_id"])
+        self.assertEqual("unit-session", envelope["session_id"])
+        self.assertEqual(64, len(envelope["state_fingerprint"]))
+        self.assertIn("live_shadow", envelope["anchors"])
+        self.assertIn("current_state", envelope["anchors"])
+        self.assertIn("next_steps", envelope["anchors"])
+        self.assertLessEqual(len(envelope.get("resume_summary", "")), 800)
+        self.assertLessEqual(len(envelope.get("open_loops", [])), 3)
+        self.assertEqual("rehydrateProjectContext", envelope["rehydrate"]["compact_action"])
+        self.assertIn("Assistant readback", envelope["plane_note"])
+
+    def test_uninitialized_protocol_default_does_not_claim_mode_authority(self) -> None:
+        envelope = build_continuity_envelope("hsp")
+        self.assertFalse(envelope["protocol"]["initialized"])
+        self.assertIsNone(envelope["protocol"]["mode"])
+        self.assertIn("BUILD-COMMIT", envelope.get("active_mode_hint", ""))
+
+    def test_fingerprint_changes_when_live_shadow_changes_and_read_does_not_mutate(self) -> None:
+        project_root = Path(r"E:\new pc\AI_Pushes_Sandbox\projects") / PROJECT_ID
+        live_shadow = project_root / "continuity" / "live_shadow" / "LIVE_SHADOW.md"
+        original = live_shadow.read_bytes()
+        before_stat = live_shadow.stat()
+        first = build_continuity_envelope(PROJECT_ID)
+        after_read_stat = live_shadow.stat()
+        self.assertEqual(before_stat.st_size, after_read_stat.st_size)
+        self.assertEqual(before_stat.st_mtime_ns, after_read_stat.st_mtime_ns)
+        try:
+            live_shadow.write_bytes(original + b"\n<!-- fingerprint-test-delta -->\n")
+            second = build_continuity_envelope(PROJECT_ID)
+            self.assertNotEqual(first["state_fingerprint"], second["state_fingerprint"])
+        finally:
+            live_shadow.write_bytes(original)
+
+
+class ContinuityEnvelopeHttpTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        os.environ["GITHOME_API_KEY"] = API_KEY
+        cls.app = create_app()
+        cls.client = cls.app.test_client()
+        cls.headers = {"X-GitHome-Key": API_KEY}
+
+    def test_authenticated_direct_action_gets_continuity(self) -> None:
+        response = self.client.post(
+            "/project/info", json={"project_id": "hsp"}, headers=self.headers
+        )
+        self.assertEqual(200, response.status_code)
+        body = response.get_json()
+        self.assertEqual("hsp", body["continuity"]["project_id"])
+
+    def test_unauthenticated_response_does_not_leak_continuity(self) -> None:
+        response = self.client.post("/project/info", json={"project_id": "hsp"})
+        self.assertEqual(401, response.status_code)
+        body = response.get_json()
+        self.assertNotIn("continuity", body)
+
+    def test_native_lab_dispatch_uses_same_top_level_envelope(self) -> None:
+        response = self.client.post(
+            "/lab/dispatch",
+            json={
+                "tool_name": "project.files.list",
+                "payload": {"project_id": "hsp", "path": "state", "limit": 3},
+            },
+            headers=self.headers,
+        )
+        self.assertEqual(200, response.status_code)
+        body = response.get_json()
+        self.assertIn("continuity", body)
+        self.assertNotIn("continuity", body.get("result", {}))
+        self.assertEqual("hsp", body["continuity"]["project_id"])
+
+    def test_structured_error_still_carries_continuity(self) -> None:
+        response = self.client.post(
+            "/project/files/read",
+            json={"project_id": "hsp", "path": "definitely-missing.txt", "max_bytes": 100},
+            headers=self.headers,
+        )
+        self.assertEqual(404, response.status_code)
+        body = response.get_json()
+        self.assertEqual("NOT_FOUND", body["error_code"])
+        self.assertEqual("hsp", body["continuity"]["project_id"])
+
+    def test_unstructured_500_is_normalized_and_carries_continuity(self) -> None:
+        response = self.client.post(
+            "/project/files/read",
+            json={
+                "project_id": "hsp",
+                "path": "state/current/CURRENT_STATE.md",
+                "start_line": 1,
+                "end_line": 2,
+                "max_bytes": 100,
+            },
+            headers=self.headers,
+        )
+        self.assertEqual(500, response.status_code)
+        self.assertTrue(response.is_json)
+        body = response.get_json()
+        self.assertEqual("UNSTRUCTURED_SERVER_ERROR", body["error_code"])
